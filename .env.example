# Secrets for hermes-jarvis. Copy to .env next to config.yaml (with Docker: data/.env) and fill in. Never commit .env.
# `hermes-jarvis init` writes this file for you, with a generated admin password.

# Password for the web UI (user: admin). Without a password the web UI is off. `hermes-jarvis init` generates one.
# To keep the password itself out of this file, put a hash here instead (made by `hermes-jarvis hash-password`)
# and remove ADMIN_PASSWORD.
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# The brain. For brain.type: hermes this is the Hermes gateway key (API_SERVER_KEY in Hermes). Extra Hermes
# profiles use <name> suffixed keys, for example HERMES_API_KEY_WORK. For brain.type: openai, set brain.api_key_env
# to the variable that holds the key for your endpoint (or leave it empty for none, like local Ollama).
HERMES_API_KEY=

# Speech to text: fill in the provider you chose in config.yaml (stt.provider).
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Optional: lets the router match a request to an earlier Hermes conversation and profile.
OPENROUTER_API_KEY=

# Optional: the device's API encryption key, if you adopted it elsewhere. `hermes-jarvis adopt` saves it for you.
ESPHOME_API_KEY=
